# MarCo environment variables.
# Copy this file to .env.local and fill in values. Never commit real keys.
# With no keys at all, MarCo runs in MOCK mode ("Mock data. Not a real audit.").

# Gemini (Google AI Studio). A key here switches MarCo out of mock mode.
GEMINI_API_KEY=
# Exact model ID confirmed to support grounding, e.g. a Gemini 2.5 Flash model.
GEMINI_MODEL_ID=

# Tavily (reads company web pages). Needed for SIMULATION mode.
TAVILY_API_KEY=

# Supabase (database, login, verification emails).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Audit mode: empty or "auto" (default), or "simulation".
# auto       -> GEMINI AUDIT (native Google Search grounding) when GEMINI_API_KEY is set.
# simulation -> SIMULATION (Gemini answers from pages fetched via Tavily); needs
#               GEMINI_API_KEY and TAVILY_API_KEY. Use if free-tier grounding is unavailable.
MARCO_AUDIT_MODE=
